UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		IsRmbHeld = true
	elseif input.KeyCode == Enum.KeyCode.K then
		ToggleMasterSwitch()
	elseif input.KeyCode == Enum.KeyCode.J then
		ToggleTriggerbot()
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		IsRmbHeld = false
	end
end)

----------------------------------------------------------------
-- TARGET ENGINE STREAM LOOP WITH MANUAL TEAM BYPASS
----------------------------------------------------------------

local function IsVisible(startPos, endPos, characterToIgnore)
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, characterToIgnore}
	raycastParams.IgnoreWater = true

	local direction = endPos - startPos
	local result = workspace:Raycast(startPos, direction, raycastParams)
	return result == nil
end

task.spawn(function()
	while task.wait(0.2) do
		local targets = {}
		local myCharacter = LocalPlayer.Character
		local checkedModels = {}

		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character then
				local char = player.Character
				checkedModels[char] = true
				
				local humanoid = char:FindFirstChildOfClass("Humanoid")
				local head = char:FindFirstChild("Head")
				local root = char:FindFirstChild("HumanoidRootPart")
				
				if humanoid and head and root and humanoid.Health > 0 then
					local shouldTarget = true
					if not Settings.TargetTeams and not Settings.RageMode then
						if player.Team == LocalPlayer.Team or player.TeamColor == LocalPlayer.TeamColor then
							shouldTarget = false
						end
					end
					
					if shouldTarget then
						table.insert(targets, {Character = char, Head = head, Root = root, Humanoid = humanoid})
					end
				end
			end
		end

		for _, obj in ipairs(workspace:GetChildren()) do
			if obj:IsA("Model") and obj ~= myCharacter and not checkedModels[obj] then
				local humanoid = obj:FindFirstChildOfClass("Humanoid")
				local head = obj:FindFirstChild("Head")
				local root = obj:FindFirstChild("HumanoidRootPart")
				
				if humanoid and head and root and humanoid.Health > 0 then
					table.insert(targets, {Character = obj, Head = head, Root = root, Humanoid = humanoid})
				end
			end
		end
		ValidTargets = targets
	end
end)

local function GetClosestTargetWorldDistance()
	local myCharacter = LocalPlayer.Character
	if not myCharacter then return nil end
	local myRoot = myCharacter:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil end

	local bestTarget = nil
	local shortestWorldDistance = math.huge
	local originPosition = Settings.RageMode and (Camera.ViewportSize / 2) or UserInputService:GetMouseLocation()

	for _, target in ipairs(ValidTargets) do
		if target.Humanoid.Health > 0 then
			local screenPos, onScreen = Camera:WorldToViewportPoint(target.Head.Position)
			
			if onScreen or Settings.RageMode then
				local allowedFov = Settings.RageMode and math.huge or Settings.FOV
				local fovDistance = onScreen and (Vector2.new(screenPos.X, screenPos.Y) - originPosition).Magnitude or 0
				
				if fovDistance < allowedFov then
					if IsVisible(Camera.CFrame.Position, target.Head.Position, target.Character) then
						local worldDistance = (target.Root.Position - myRoot.Position).Magnitude
						if worldDistance < shortestWorldDistance then
							shortestWorldDistance = worldDistance
							bestTarget = target.Head
						end
					end
				end
			end
		end
	end
	return bestTarget
end

----------------------------------------------------------------
-- ESP BOX RENDERING SYSTEM
----------------------------------------------------------------

local function CreateEspBox()
	local box = Drawing.new("Square")
	box.Visible = false
	box.Color = Color3.fromRGB(255, 0, 0)
	box.Thickness = 1
	box.Filled = false
	box.Transparency = 0.8
	return box
end

local function UpdateEspBoxes()
	local activeCharacters = {}

	for _, target in ipairs(ValidTargets) do
		if target.Humanoid.Health > 0 then
			local char = target.Character
			activeCharacters[char] = true

			if not EspCache[char] then
				EspCache[char] = CreateEspBox()
			end

			local box = EspCache[char]
			local rootPos, rootOnScreen = Camera:WorldToViewportPoint(target.Root.Position)

			if rootOnScreen then
				local topPos = Camera:WorldToViewportPoint(target.Root.Position + Vector3.new(0, 3.5, 0))
				local bottomPos = Camera:WorldToViewportPoint(target.Root.Position - Vector3.new(0, 3.5, 0))
				
				local boxHeight = math.abs(topPos.Y - bottomPos.Y)
				local boxWidth = boxHeight * 0.65

				box.Size = Vector2.new(boxWidth, boxHeight)
				box.Position = Vector2.new(rootPos.X - (boxWidth / 2), rootPos.Y - (boxHeight / 2))
				box.Visible = true
			else
				box.Visible = false
			end
		end
	end

	for char, box in pairs(EspCache) do
		if not activeCharacters[char] then
			box.Visible = false
			box:Remove()
			EspCache[char] = nil
		end
	end
end

