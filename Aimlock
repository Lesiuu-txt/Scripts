task.spawn(function()
	local VirtualUser = game:GetService("VirtualUser")
	
	while true do
		if Settings.TargetLock and (Settings.Triggerbot or Settings.RageMode) then
			if IsRmbHeld or Settings.RageMode then
				local targetHead = GetClosestTargetWorldDistance()
				
				if targetHead then
					-- Dynamic injection logic using updated slider settings values
					local currentDelay = Settings.RageMode and 0.01 or Settings.ShotDelay
					if currentDelay > 0 then
						task.wait(currentDelay)
					end

					VirtualUser:Button1Down(Vector2.new(0, 0), Camera.CFrame)
					if typeof(mouse1click) == "function" then mouse1click() end
					
					task.wait(0.01)
					
					VirtualUser:Button1Up(Vector2.new(0, 0), Camera.CFrame)
				end
			end
		end
		task.wait(0.01) 
	end
end)

----------------------------------------------------------------
-- RUNTIME LOOP ENGINE (AIMLOCK & VISUALS ONLY)
----------------------------------------------------------------

RunService.RenderStepped:Connect(function(deltaTime)
	UpdateEspBoxes()

	if Settings.TargetLock and (IsRmbHeld or Settings.RageMode) then
		local targetHead = GetClosestTargetWorldDistance()
		
		if targetHead then
			local targetCFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)
			local speedAlpha
			
			if Settings.RageMode or Settings.Smoothness == 100 then
				speedAlpha = 1 
			else
				speedAlpha = math.clamp((Settings.Smoothness * 0.25) * deltaTime, 0.001, 1)
			end
			Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, speedAlpha)
		end
	end
end)
