local function unload()
    -- 1) wylacz aktywne funkcje i przyroc ustawienia postaci
    pcall(stopFly)
    if noclipEnabled then setNoclip(false) end
    for plr in pairs(espDrawings) do removeESP(plr) end
    espEnabled = false
    if getCharacter() and walkMultiplier ~= 1 then
        humanoid.WalkSpeed = originalWalkSpeed
    end

    -- 2) odlacz wszystkie nasluchiwania
    local conns = {
        flyConnection, noclipConnection, espConnection,
        jumpConn, inputBeganConn, inputChangedConn, inputEndedConn,
        charAddedConn, playerRemovingConn,
    }
    for _, c in ipairs(conns) do
        if c then c:Disconnect() end
    end
    flyConnection, noclipConnection, espConnection = nil, nil, nil
    jumpConn, inputBeganConn, inputChangedConn, inputEndedConn = nil, nil, nil, nil
    charAddedConn, playerRemovingConn = nil, nil

    -- 3) zniszcz GUI
    if screenGui then
        screenGui:Destroy()
        screenGui = nil
    end

    -- 4) wyczysc globalny uchwyt (mozliwy ponowny start od zera)
    if G then G.LesiuuHubUnload = nil end
    print("✅ LesiuuHub unloaded")
end

