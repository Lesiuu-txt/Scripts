-- ====================== ESP ======================
local function removeESP(plr)
    local d = espDrawings[plr]
    if d then
        d.box:Remove()
        d.name:Remove()
        espDrawings[plr] = nil
    end
end

local function createESP(plr)
    local box = Drawing.new("Square")
    box.Thickness = 2
    box.Color = Color3.fromRGB(255, 0, 255)
    box.Transparency = 1
    box.Filled = false
    box.Visible = false

    local nameText = Drawing.new("Text")
    nameText.Size = 16
    nameText.Color = Color3.fromRGB(255, 255, 255)
    nameText.Outline = true
    nameText.Center = true
    nameText.Visible = false

    espDrawings[plr] = {box = box, name = nameText}
end

local function updateESP()
    local cam = workspace.CurrentCamera
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local head = char and char:FindFirstChild("Head")
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            if not espDrawings[plr] then createESP(plr) end
            local d = espDrawings[plr]

            local visible = false
            if hrp and head and hum and hum.Health > 0 then
                local _, onScreen = cam:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    local top = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 1, 0))
                    local bottom = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                    local height = math.abs(bottom.Y - top.Y)
                    local width = height / 2

                    d.box.Size = Vector2.new(width, height)
                    d.box.Position = Vector2.new(top.X - width / 2, top.Y)
                    d.name.Text = plr.Name .. " [" .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth) .. "]"
                    d.name.Position = Vector2.new(top.X, top.Y - 20)
                    visible = true
                end
            end
            d.box.Visible = visible
            d.name.Visible = visible
        end
    end
end

