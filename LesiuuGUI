-- ====================== SUWAKI ======================
local flySpeeds = {16, 32, 64, 128, 512}
local multipliers = {1, 2, 4, 8, 32}
local activeSlider = nil

local function updateSlider(track, knob, values, posX, onChange)
    local percent = math.clamp((posX - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
    local index = math.round(percent * (#values - 1)) + 1
    knob.Position = UDim2.new((index - 1) / (#values - 1), -12, 0.5, -12)
    onChange(values[index])
end

local function setFlySpeed(v)
    flySpeed = v
    flySpeedLabel.Text = "Fly Speed: " .. v
end

local function setWalk(v)
    walkMultiplier = v
    walkLabel.Text = "Walk Speed: " .. v .. "x"
    applyWalkSpeed()
end

local function isPress(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
end

flyKnob.InputBegan:Connect(function(i) if isPress(i) then activeSlider = "fly" end end)
walkKnob.InputBegan:Connect(function(i) if isPress(i) then activeSlider = "walk" end end)

inputChangedConn = UserInputService.InputChanged:Connect(function(input)
    if not activeSlider then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local x = input.Position.X
    if activeSlider == "fly" then
        updateSlider(flyTrack, flyKnob, flySpeeds, x, setFlySpeed)
    else
        updateSlider(walkTrack, walkKnob, multipliers, x, setWalk)
    end
end)

inputEndedConn = UserInputService.InputEnded:Connect(function(input)
    if isPress(input) then activeSlider = nil end
end)

