-- Sliders and Fly Logic (same as previous stable version)
local flySpeeds = {16, 32, 64, 128, 512}
local multipliers = {1, 2, 4, 8, 32}
local draggingFly = false
local draggingWalk = false

flyKnob.MouseButton1Down:Connect(function() draggingFly = true end)
walkKnob.MouseButton1Down:Connect(function() draggingWalk = true end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        draggingFly = false
        draggingWalk = false
    end
end)

RunService.RenderStepped:Connect(function()
    local mouseX = UserInputService:GetMouseLocation().X

    if draggingFly then
        local percent = math.clamp((mouseX - flyTrack.AbsolutePosition.X) / flyTrack.AbsoluteSize.X, 0, 1)
        local index = math.round(percent * (#flySpeeds-1)) + 1
        flySpeed = flySpeeds[index]
        flySpeedLabel.Text = "Fly Speed: " .. flySpeed
        flyKnob.Position = UDim2.new((index-1)/(#flySpeeds-1), -12, 0.5, -12)
    end

    if draggingWalk then
        local percent = math.clamp((mouseX - walkTrack.AbsolutePosition.X) / walkTrack.AbsoluteSize.X, 0, 1)
        local index = math.round(percent * (#multipliers-1)) + 1
        walkMultiplier = multipliers[index]
        walkLabel.Text = "Walk Speed: " .. walkMultiplier .. "x"
        
        if player.Character and player.Character:FindFirstChild("Humanoid") then
            player.Character.Humanoid.WalkSpeed = originalWalkSpeed * walkMultiplier
        end
        
        walkKnob.Position = UDim2.new((index-1)/(#multipliers-1), -12, 0.5, -12)
    end
end)

-- Fly Logic
local character, root, humanoid

local function startFly()
    if flying then return end
    flying = true
    character = player.Character or player.CharacterAdded:Wait()
    root = character:WaitForChild("HumanoidRootPart")
    humanoid = character:WaitForChild("Humanoid")
    
    humanoid.PlatformStand = true
    if noclipEnabled then updateNoclip() end

    connection = RunService.Heartbeat:Connect(function()
        if not (flying and root) then return end
        local cam = workspace.CurrentCamera
        local moveDir = Vector3.new()

        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir -= cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir += cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir -= cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir -= Vector3.new(0,1,0) end

        if moveDir.Magnitude > 0.1 then
            root.AssemblyLinearVelocity = moveDir.Unit * flySpeed
        else
            root.AssemblyLinearVelocity = Vector3.new(0, hoverPower, 0)
        end

        local look = cam.CFrame.LookVector
        root.CFrame = CFrame.lookAt(root.Position, root.Position + Vector3.new(look.X, 0, look.Z))
    end)

    statusLabel.Text = "Status: FLYING"
    statusLabel.TextColor3 = Color3.fromRGB(100, 255, 140)
end

local function stopFly()
    if not flying then return end
    flying = false
    if connection then connection:Disconnect() end
    if humanoid then humanoid.PlatformStand = false end
    if root then root.AssemblyLinearVelocity = Vector3.new(0,0,0) end
    statusLabel.Text = "Status: OFF"
    statusLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.F then
        if flying then stopFly() else startFly() end
    end
end)

